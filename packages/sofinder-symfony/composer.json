{
    "name": "sohophp/sofinder-symfony",
    "description": "Symfony 6.4/7.4 bridge for SoFinder",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://sofinder.sohophp.app/",
    "keywords": ["file-manager", "symfony", "ckeditor", "upload"],
    "support": {
        "issues": "https://github.com/sohophp/sofinder/issues",
        "source": "https://github.com/sohophp/sofinder"
    },
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "nyholm/psr7": "^1.8",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "sohophp/sofinder-core": "self.version",
        "sohophp/sofinder-http": "self.version",
        "symfony/config": "^6.4 || ^7.4",
        "symfony/console": "^6.4 || ^7.4",
        "symfony/dependency-injection": "^6.4 || ^7.4",
        "symfony/event-dispatcher": "^6.4 || ^7.4",
        "symfony/filesystem": "^6.4 || ^7.4",
        "symfony/http-foundation": "^6.4 || ^7.4",
        "symfony/http-kernel": "^6.4 || ^7.4",
        "symfony/psr-http-message-bridge": "^6.4 || ^7.4",
        "symfony/routing": "^6.4 || ^7.4",
        "symfony/security-core": "^6.4 || ^7.4",
        "symfony/security-csrf": "^6.4 || ^7.4"
    },
    "conflict": {
        "sohophp/sofinder-legacy": "*"
    },
    "suggest": {
        "ext-gd": "Required for thumbnails and image editing",
        "ext-imagick": "Adds additional image format support",
        "ext-zip": "Required for ZIP archive downloads",
        "symfony/messenger": "Enables asynchronous maintenance and document preview jobs"
    },
    "autoload": {
        "psr-4": {
            "SohoPHP\\SoFinder\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
