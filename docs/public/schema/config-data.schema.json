{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofinder.sohophp.app/schema/config-data.schema.json",
  "title": "SoFinder API discovery data",
  "type": "object",
  "additionalProperties": true,
  "required": ["apiVersion", "resources", "plugins", "imagePresets", "imageCapabilities", "uiDefaults", "featureAvailability", "signedUrls"],
  "properties": {
    "apiVersion": {"type": "string", "pattern": "^1\\."},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "plugins": {"type": "array", "items": {"$ref": "#/$defs/plugin"}},
    "imagePresets": {"type": "object", "additionalProperties": {"type": "object", "required": ["width", "height", "quality"]}},
    "imageCapabilities": {"type": "object", "required": ["driver", "formats"], "properties": {"driver": {"enum": ["", "auto", "gd", "imagick"]}, "formats": {"type": "array", "items": {"$ref": "#/$defs/imageFormat"}}}},
    "uiDefaults": {"type": "object"},
    "featureAvailability": {"type": "object", "additionalProperties": false, "required": ["folderTree", "recent", "favorites", "tags", "archive", "trash", "batchRename", "imageEditing", "imageProcessing", "documentPreview", "securityStatus", "folderUpload", "textPreview", "checksum"], "properties": {"folderTree": {"type": "boolean"}, "recent": {"type": "boolean"}, "favorites": {"type": "boolean"}, "tags": {"type": "boolean"}, "archive": {"type": "boolean"}, "trash": {"type": "boolean"}, "batchRename": {"type": "boolean"}, "imageEditing": {"type": "boolean"}, "imageProcessing": {"type": "boolean"}, "documentPreview": {"type": "boolean"}, "securityStatus": {"type": "boolean"}, "folderUpload": {"type": "boolean"}, "textPreview": {"type": "boolean"}, "checksum": {"type": "boolean"}}},
    "signedUrls": {"type": "object", "additionalProperties": false, "required": ["enabled", "defaultTtlSeconds", "maxTtlSeconds"], "properties": {"enabled": {"type": "boolean"}, "defaultTtlSeconds": {"type": "integer", "minimum": 30, "maximum": 86400}, "maxTtlSeconds": {"type": "integer", "minimum": 30, "maximum": 86400}}}
  },
  "$defs": {
    "entryCapabilities": {"type": "object", "description": "Authorization hints only; every operation is re-authorized by the server.", "additionalProperties": {"type": "boolean"}},
    "storageCapabilities": {"type": "object", "additionalProperties": false, "required": ["search", "sort", "cursorPagination", "atomicMove", "nativeCopy", "recoverableDelete", "publicUrl"], "properties": {"search": {"type": "boolean"}, "sort": {"type": "boolean"}, "cursorPagination": {"type": "boolean"}, "atomicMove": {"type": "boolean"}, "nativeCopy": {"type": "boolean"}, "recoverableDelete": {"type": "boolean"}, "publicUrl": {"type": "boolean"}}},
    "resource": {"type": "object", "additionalProperties": true, "required": ["name", "publicUrl", "allowedExtensions", "maxSize", "readOnly", "quotaBytes", "deliveryMode", "storageCapabilities"], "properties": {"name": {"type": "string", "minLength": 1}, "publicUrl": {"type": "string"}, "allowedExtensions": {"type": "array", "items": {"type": "string"}}, "maxSize": {"type": "integer", "minimum": 1}, "readOnly": {"type": "boolean"}, "quotaBytes": {"type": "integer", "minimum": 0}, "deliveryMode": {"enum": ["public", "proxy"]}, "entryUrlConfigured": {"type": "boolean", "description": "True when copied entry URLs are owned by a configured host route."}, "storageCapabilities": {"$ref": "#/$defs/storageCapabilities"}}},
    "plugin": {"type": "object", "additionalProperties": true, "required": ["name", "version", "capabilities"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "version": {"type": "string"}, "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}}, "resourceTypes": {"type": "array", "uniqueItems": true, "items": {"enum": ["any", "file", "image", "directory"]}}, "requiredOperations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "configurationKeys": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "uiActions": {"type": "array"}, "previewers": {"type": "array"}}},
    "imageFormat": {"type": "object", "additionalProperties": false, "required": ["format", "extensions", "mimes", "processor", "read", "edit", "thumbnail", "webEmbeddable"], "properties": {"format": {"type": "string"}, "extensions": {"type": "array", "items": {"type": "string"}}, "mimes": {"type": "array", "items": {"type": "string"}}, "processor": {"enum": ["", "gd", "imagick"]}, "read": {"type": "boolean"}, "edit": {"type": "boolean"}, "thumbnail": {"type": "boolean"}, "webEmbeddable": {"type": "boolean"}}}
  }
}
