{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofinder.sohophp.app/schema/config-data.schema.json",
  "title": "SoFinder API discovery data",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "resources", "plugins", "imagePresets", "imageCapabilities", "uiDefaults", "featureAvailability", "signedUrls", "assetCatalog", "assetSearch", "assetUsage", "assetAccessSessions", "imageVariants"],
  "properties": {
    "apiVersion": {"type": "string", "pattern": "^1\\."},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "plugins": {"type": "array", "items": {"$ref": "#/$defs/plugin"}},
    "imagePresets": {"type": "object", "additionalProperties": {"type": "object", "required": ["width", "height", "quality"]}},
    "imageCapabilities": {"type": "object", "required": ["driver", "formats"], "properties": {"driver": {"enum": ["", "auto", "gd", "imagick"]}, "formats": {"type": "array", "items": {"$ref": "#/$defs/imageFormat"}}}},
    "uiDefaults": {"type": "object", "additionalProperties": false, "required": ["scale"], "properties": {"scale": {"enum": ["compact", "standard", "large", "xlarge"]}, "mode": {"enum": ["manager", "picker"]}, "header": {"type": "boolean"}, "logo": {"type": "boolean"}, "search": {"type": "boolean"}, "languageSwitcher": {"type": "boolean"}, "viewSwitcher": {"type": "boolean"}, "fullTools": {"type": "boolean"}, "uploadConflictStrategy": {"enum": ["ask", "rename", "overwrite", "skip"]}, "lowercaseUploadExtensions": {"type": "boolean"}}},
    "featureAvailability": {"type": "object", "additionalProperties": false, "required": ["folderTree", "recent", "favorites", "quickAccess", "quickAccessFiles", "tags", "archive", "trash", "batchRename", "imageEditing", "imageProcessing", "documentPreview", "securityStatus", "folderUpload", "textPreview", "checksum", "qrCode"], "properties": {"folderTree": {"type": "boolean"}, "recent": {"type": "boolean"}, "favorites": {"type": "boolean"}, "quickAccess": {"type": "boolean"}, "quickAccessFiles": {"type": "boolean"}, "tags": {"type": "boolean"}, "archive": {"type": "boolean"}, "trash": {"type": "boolean"}, "batchRename": {"type": "boolean"}, "imageEditing": {"type": "boolean"}, "imageProcessing": {"type": "boolean"}, "documentPreview": {"type": "boolean"}, "securityStatus": {"type": "boolean"}, "folderUpload": {"type": "boolean"}, "textPreview": {"type": "boolean"}, "checksum": {"type": "boolean"}, "qrCode": {"type": "boolean"}}},
    "signedUrls": {"type": "object", "additionalProperties": false, "required": ["enabled", "defaultTtlSeconds", "maxTtlSeconds"], "properties": {"enabled": {"type": "boolean"}, "defaultTtlSeconds": {"type": "integer", "minimum": 30, "maximum": 86400}, "maxTtlSeconds": {"type": "integer", "minimum": 30, "maximum": 86400}}},
    "assetCatalog": {"type": "object", "additionalProperties": false, "required": ["enabled", "altLocales"], "properties": {"enabled": {"type": "boolean"}, "altLocales": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})*$"}}}},
    "assetSearch": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
    "assetUsage": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
    "assetAccessSessions": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
    "imageVariants": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}}
  },
  "$defs": {
    "entryCapabilities": {"type": "object", "description": "Authorization hints only; every operation is re-authorized by the server.", "additionalProperties": {"type": "boolean"}},
    "storageCapabilities": {"type": "object", "additionalProperties": false, "required": ["search", "sort", "cursorPagination", "atomicMove", "nativeCopy", "recoverableDelete", "publicUrl"], "properties": {"search": {"type": "boolean"}, "sort": {"type": "boolean"}, "cursorPagination": {"type": "boolean"}, "atomicMove": {"type": "boolean"}, "nativeCopy": {"type": "boolean"}, "recoverableDelete": {"type": "boolean"}, "publicUrl": {"type": "boolean"}}},
    "resource": {"type": "object", "additionalProperties": false, "required": ["name", "publicUrl", "allowedExtensions", "allowedMimeTypes", "maxSize", "readOnly", "quotaBytes", "usedBytes", "maxFileNameLength", "maxFolderNameLength", "maxFolderDepth", "maxImagePixels", "deliveryMode", "entryUrlConfigured", "storageCapabilities", "maxBatchItems", "maxRecursiveItems", "maxArchiveItems", "maxArchiveBytes", "maxImageWidth", "maxImageHeight", "animatedImagePolicy"], "properties": {"name": {"type": "string", "minLength": 1}, "publicUrl": {"type": "string"}, "allowedExtensions": {"type": "array", "items": {"type": "string"}}, "allowedMimeTypes": {"type": "array", "items": {"type": "string"}}, "maxSize": {"type": "integer", "minimum": 1}, "readOnly": {"type": "boolean"}, "quotaBytes": {"type": "integer", "minimum": 0}, "usedBytes": {"type": "integer", "minimum": 0}, "maxFileNameLength": {"type": "integer", "minimum": 1}, "maxFolderNameLength": {"type": "integer", "minimum": 1}, "maxFolderDepth": {"type": "integer", "minimum": 1}, "maxImagePixels": {"type": "integer", "minimum": 1}, "deliveryMode": {"enum": ["public", "proxy"]}, "entryUrlConfigured": {"type": "boolean", "description": "True when copied entry URLs are owned by a configured host route."}, "storageCapabilities": {"$ref": "#/$defs/storageCapabilities"}, "maxBatchItems": {"type": "integer", "minimum": 1}, "maxRecursiveItems": {"type": "integer", "minimum": 1}, "maxArchiveItems": {"type": "integer", "minimum": 1}, "maxArchiveBytes": {"type": "integer", "minimum": 1}, "maxImageWidth": {"type": "integer", "minimum": 1}, "maxImageHeight": {"type": "integer", "minimum": 1}, "animatedImagePolicy": {"enum": ["preserve", "reject"]}}},
    "plugin": {"$ref": "plugin-descriptor.schema.json"},
    "imageFormat": {"type": "object", "additionalProperties": false, "required": ["format", "extensions", "mimes", "processor", "read", "edit", "thumbnail", "webEmbeddable"], "properties": {"format": {"type": "string"}, "extensions": {"type": "array", "items": {"type": "string"}}, "mimes": {"type": "array", "items": {"type": "string"}}, "processor": {"enum": ["", "gd", "imagick"]}, "read": {"type": "boolean"}, "edit": {"type": "boolean"}, "thumbnail": {"type": "boolean"}, "webEmbeddable": {"type": "boolean"}}}
  }
}
