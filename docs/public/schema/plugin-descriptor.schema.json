{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofinder.sohophp.app/schema/plugin-descriptor.schema.json",
  "title": "SoFinder declarative plugin descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "capabilities"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"},
    "capabilities": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"}},
    "resourceTypes": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"enum": ["any", "file", "image", "directory"]}},
    "requiredOperations": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"}},
    "configurationKeys": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}},
    "uiActions": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/uiAction"}},
    "previewers": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/previewer"}}
  },
  "$defs": {
    "labels": {"type": "object", "additionalProperties": false, "required": ["en"], "properties": {"en": {"type": "string", "minLength": 1, "maxLength": 48}, "zh-cn": {"type": "string", "minLength": 1, "maxLength": 48}, "zh-tw": {"type": "string", "minLength": 1, "maxLength": 48}}},
    "sameOriginPath": {"type": "string", "maxLength": 512, "pattern": "^/(?!/)[^\\u0000-\\u0020\\u007f]*$"},
    "uiAction": {"type": "object", "additionalProperties": false, "required": ["id", "label", "slot", "url"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$"}, "label": {"$ref": "#/$defs/labels"}, "slot": {"enum": ["utility", "toolbar", "context", "details"]}, "url": {"$ref": "#/$defs/sameOriginPath"}, "selection": {"enum": ["none", "any", "file", "image"], "default": "any"}, "requires": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$", "default": "read"}}},
    "previewer": {"type": "object", "additionalProperties": false, "required": ["id", "url"], "anyOf": [{"required": ["mimeTypes"]}, {"required": ["extensions"]}], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$"}, "mimeTypes": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9.+_-]+/[a-z0-9.+*_-]+$"}}, "extensions": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.+_-]{0,15}$"}}, "url": {"$ref": "#/$defs/sameOriginPath"}}}
  }
}
