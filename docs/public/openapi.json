{
  "openapi": "3.1.0",
  "info": {
    "title": "SoFinder HTTP API",
    "version": "1.0",
    "description": "Stable same-origin authenticated API. Mutations also require X-CSRF-TOKEN."
  },
  "servers": [{"url": "/sofinder"}],
  "security": [{"sessionCookie": []}],
  "paths": {
    "/api/config": {"get": {"operationId": "getConfig", "responses": {"200": {"description": "Versioned discovery data", "content": {"application/json": {"schema": {"type": "object", "required": ["success", "data"], "properties": {"success": {"const": true}, "data": {"$ref": "./schema/config-data.schema.json"}}}}}}}}},
    "/api/capabilities": {"get": {"operationId": "getCapabilities", "responses": {"200": {"description": "Versioned machine-readable capability catalog", "content": {"application/json": {"schema": {"type": "object", "required": ["success", "data"], "properties": {"success": {"const": true}, "data": {"$ref": "./schema/capability-catalog.schema.json"}}}}}}}}},
    "/health": {"get": {"operationId": "getHealth", "responses": {"200": {"$ref": "#/components/responses/Success"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/live": {"get": {"operationId": "getLiveness", "responses": {"200": {"description": "Process and bundle initialization status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LivenessEnvelope"}}}}}}},
    "/metrics": {"get": {"operationId": "getMetrics", "responses": {"200": {"description": "Prometheus text exposition", "content": {"text/plain": {"schema": {"type": "string"}}}}}}},
    "/api/security/status": {"get": {"operationId": "getSecurityStatus", "responses": {"200": {"$ref": "#/components/responses/Success"}}}},
    "/api/entries": {
      "get": {"operationId": "listEntries", "parameters": [{"$ref": "#/components/parameters/resource"}, {"$ref": "#/components/parameters/path"}, {"name": "search", "in": "query", "schema": {"type": "string", "default": ""}}, {"name": "searchMode", "in": "query", "schema": {"enum": ["name", "tags"], "default": "name"}}, {"name": "sort", "in": "query", "schema": {"enum": ["name", "size", "type", "modified"], "default": "name"}}, {"name": "direction", "in": "query", "schema": {"enum": ["asc", "desc"], "default": "asc"}}, {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0, "default": 0}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 10, "maximum": 500, "default": 100}}, {"name": "cursor", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"$ref": "#/components/responses/Success"}}},
      "delete": {"operationId": "deleteEntry", "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"$ref": "#/components/requestBodies/JsonMutation"}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/folders": {"post": {"operationId": "createFolder", "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"$ref": "#/components/requestBodies/JsonMutation"}, "responses": {"201": {"$ref": "#/components/responses/Success"}}}},
    "/api/uploads": {"post": {"operationId": "uploadFile", "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"description": "Multipart upload field plus resource/path policy fields", "required": true, "content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/UploadRequest"}}}}, "responses": {"201": {"$ref": "#/components/responses/Success"}, "413": {"$ref": "#/components/responses/Error"}, "415": {"$ref": "#/components/responses/Error"}}}},
    "/api/uploads/chunks": {"post": {"operationId": "uploadChunk", "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"description": "Multipart resumable chunk", "required": true, "content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/ChunkUploadRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "201": {"$ref": "#/components/responses/Success"}}}},
    "/api/uploads/chunks/{id}": {
      "parameters": [{"$ref": "#/components/parameters/id"}],
      "get": {"operationId": "getChunkStatus", "responses": {"200": {"$ref": "#/components/responses/Success"}}},
      "delete": {"operationId": "cancelChunkUpload", "parameters": [{"$ref": "#/components/parameters/csrf"}], "responses": {"200": {"$ref": "#/components/responses/Success"}}}
    },
    "/api/entries/rename": {"patch": {"operationId": "renameEntry", "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"$ref": "#/components/requestBodies/JsonMutation"}, "responses": {"200": {"$ref": "#/components/responses/Success"}}}},
    "/api/entries/copy": {"post": {"operationId": "copyEntry", "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"$ref": "#/components/requestBodies/JsonMutation"}, "responses": {"200": {"$ref": "#/components/responses/Success"}}}},
    "/api/entries/move": {"post": {"operationId": "moveEntry", "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"$ref": "#/components/requestBodies/JsonMutation"}, "responses": {"200": {"$ref": "#/components/responses/Success"}}}},
    "/api/entries/batch": {"post": {"operationId": "batchEntries", "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"$ref": "#/components/requestBodies/JsonMutation"}, "responses": {"200": {"$ref": "#/components/responses/Success"}}}},
    "/api/entries/batch-rename": {"post": {"operationId": "batchRenameEntries", "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"$ref": "#/components/requestBodies/JsonMutation"}, "responses": {"200": {"$ref": "#/components/responses/Success"}}}},
    "/api/download": {"get": {"operationId": "downloadEntry", "parameters": [{"$ref": "#/components/parameters/resource"}, {"$ref": "#/components/parameters/path"}], "responses": {"200": {"description": "File attachment", "content": {"application/octet-stream": {"schema": {"type": "string", "contentEncoding": "binary"}}}}}}},
    "/api/content": {"get": {"operationId": "streamContent", "parameters": [{"$ref": "#/components/parameters/resource"}, {"$ref": "#/components/parameters/path"}], "responses": {"200": {"description": "Authorized content"}, "206": {"description": "Single byte range"}, "416": {"$ref": "#/components/responses/Error"}}}},
    "/api/signed-url": {"get": {"operationId": "issueSignedUrl", "parameters": [{"$ref": "#/components/parameters/resource"}, {"$ref": "#/components/parameters/path"}, {"name": "ttl", "in": "query", "schema": {"type": "integer", "minimum": 30}}, {"name": "disposition", "in": "query", "schema": {"enum": ["inline", "attachment"]}}], "responses": {"200": {"$ref": "#/components/responses/Success"}, "422": {"$ref": "#/components/responses/Error"}}}},
    "/signed/{token}": {"get": {"operationId": "consumeSignedUrl", "security": [], "parameters": [{"name": "token", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Revision-bound temporary file content"}, "206": {"description": "Single byte range"}, "403": {"$ref": "#/components/responses/Error"}, "410": {"$ref": "#/components/responses/Error"}}}},
    "/api/checksum": {"get": {"operationId": "getChecksum", "parameters": [{"$ref": "#/components/parameters/resource"}, {"$ref": "#/components/parameters/path"}], "responses": {"200": {"$ref": "#/components/responses/Success"}}}},
    "/api/preview/text": {"get": {"operationId": "getTextPreview", "parameters": [{"$ref": "#/components/parameters/resource"}, {"$ref": "#/components/parameters/path"}], "responses": {"200": {"$ref": "#/components/responses/Success"}, "415": {"$ref": "#/components/responses/Error"}}}},
    "/api/preview/document": {"get": {"operationId": "getDocumentPreview", "parameters": [{"$ref": "#/components/parameters/resource"}, {"$ref": "#/components/parameters/path"}], "responses": {"200": {"description": "Inline sandboxed PDF preview", "content": {"application/pdf": {"schema": {"type": "string", "contentEncoding": "binary"}}}}, "202": {"description": "Office preview conversion is pending", "headers": {"Retry-After": {"schema": {"type": "integer", "minimum": 1}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}, "413": {"$ref": "#/components/responses/Error"}, "415": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/preview/document/jobs": {"post": {"operationId": "createDocumentPreviewJob", "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DocumentPreviewJobRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/DocumentPreviewJob"}, "202": {"$ref": "#/components/responses/DocumentPreviewJob"}, "400": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/Error"}, "415": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/preview/document/jobs/{id}": {"get": {"operationId": "getDocumentPreviewJob", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-f0-9]{48}$"}}], "responses": {"200": {"$ref": "#/components/responses/DocumentPreviewJob"}, "202": {"$ref": "#/components/responses/DocumentPreviewJob"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/trash": {"get": {"operationId": "listTrash", "parameters": [{"$ref": "#/components/parameters/resource"}], "responses": {"200": {"$ref": "#/components/responses/Success"}}}},
    "/api/trash/{id}/restore": {"post": {"operationId": "restoreTrash", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/csrf"}], "requestBody": {"$ref": "#/components/requestBodies/JsonMutation"}, "responses": {"200": {"$ref": "#/components/responses/Success"}}}},
    "/api/trash/{id}": {"delete": {"operationId": "deleteTrash", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/csrf"}], "requestBody": {"$ref": "#/components/requestBodies/JsonMutation"}, "responses": {"200": {"$ref": "#/components/responses/Success"}}}},
    "/api/images/thumbnail": {"get": {"operationId": "getThumbnail", "parameters": [{"$ref": "#/components/parameters/resource"}, {"$ref": "#/components/parameters/path"}], "responses": {"200": {"description": "Browser-safe thumbnail"}}}},
    "/api/images/info": {"get": {"operationId": "getImageInfo", "parameters": [{"$ref": "#/components/parameters/resource"}, {"$ref": "#/components/parameters/path"}], "responses": {"200": {"$ref": "#/components/responses/Success"}}}},
    "/api/images/edit": {"patch": {"operationId": "editImage", "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"$ref": "#/components/requestBodies/ImageEdit"}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "415": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}}},
    "/api/images/batch": {"patch": {"operationId": "batchEditImages", "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"$ref": "#/components/requestBodies/ImageBatch"}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "415": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}}},
    "/api/archive": {"post": {"operationId": "downloadArchive", "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"$ref": "#/components/requestBodies/JsonMutation"}, "responses": {"200": {"description": "Bounded ZIP archive"}}}},
    "/api/metadata": {
      "get": {"operationId": "getMetadata", "parameters": [{"$ref": "#/components/parameters/resource"}], "responses": {"200": {"$ref": "#/components/responses/Success"}}},
      "patch": {"operationId": "updateMetadata", "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"$ref": "#/components/requestBodies/JsonMutation"}, "responses": {"200": {"$ref": "#/components/responses/Success"}}}
    },
    "/compat/ckeditor4/upload": {"post": {"operationId": "ckeditor4Upload", "requestBody": {"description": "CKEditor multipart upload", "required": true, "content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/CkeditorUploadRequest"}}}}, "responses": {"200": {"description": "CKEditor callback or JSON response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CkeditorUploadResponse"}}, "text/html": {"schema": {"type": "string"}}}}}}}
  },
  "components": {
    "securitySchemes": {"sessionCookie": {"type": "apiKey", "in": "cookie", "name": "PHPSESSID"}},
    "parameters": {
      "resource": {"name": "resource", "in": "query", "schema": {"type": "string", "default": "Files"}},
      "path": {"name": "path", "in": "query", "schema": {"type": "string"}},
      "id": {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
      "csrf": {"name": "X-CSRF-TOKEN", "in": "header", "required": true, "schema": {"type": "string"}}
    },
    "requestBodies": {
      "JsonMutation": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MutationRequest"}}}},
      "ImageEdit": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ImageEditRequest"}}}},
      "ImageBatch": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ImageBatchRequest"}}}}
    },
    "schemas": {
      "SuccessEnvelope": {"type": "object", "additionalProperties": false, "required": ["success", "data"], "properties": {"success": {"const": true}, "data": {"$ref": "#/components/schemas/ApiData"}}},
      "ErrorEnvelope": {"$ref": "./schema/error-envelope.schema.json"},
      "PickerEntry": {"$ref": "./schema/picker-entry.schema.json"},
      "ImageActions": {"$ref": "./schema/image-actions.schema.json"},
      "Entry": {"type": "object", "additionalProperties": false, "required": ["path", "name", "directory", "size", "modifiedAt", "mimeType", "url", "capabilities"], "properties": {"path": {"type": "string"}, "name": {"type": "string"}, "directory": {"type": "boolean"}, "size": {"type": "integer", "minimum": 0}, "modifiedAt": {"type": "integer", "minimum": 0}, "mimeType": {"type": ["string", "null"]}, "url": {"type": ["string", "null"]}, "capabilities": {"type": "object", "additionalProperties": {"type": "boolean"}}}},
      "EntryResult": {"type": "object", "additionalProperties": false, "required": ["entry"], "properties": {"entry": {"$ref": "#/components/schemas/Entry"}}},
      "EntryList": {"type": "object", "additionalProperties": false, "required": ["entries", "total", "path", "offset", "limit", "nextCursor", "sort", "direction", "capabilities"], "properties": {"entries": {"type": "array", "items": {"$ref": "#/components/schemas/Entry"}}, "total": {"type": ["integer", "null"], "minimum": 0}, "path": {"type": "string"}, "offset": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 500}, "nextCursor": {"type": ["string", "null"]}, "sort": {"enum": ["name", "size", "type", "modified"]}, "direction": {"enum": ["asc", "desc"]}, "capabilities": {"type": "object", "additionalProperties": {"type": "boolean"}}}},
      "EmptyData": {"type": "object", "additionalProperties": false, "maxProperties": 0},
      "HealthData": {"type": "object", "additionalProperties": false, "required": ["status", "checks"], "properties": {"status": {"enum": ["ready", "degraded", "down"]}, "checks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "status", "message"], "properties": {"name": {"type": "string"}, "status": {"enum": ["ready", "degraded", "down"]}, "message": {"type": "string", "maxLength": 256}}}}}},
      "SecurityStatusData": {"type": "object", "additionalProperties": false, "required": ["malwareScanning"], "properties": {"malwareScanning": {"type": "object", "additionalProperties": false, "required": ["enabled", "provider", "status", "message", "counts", "recent", "mode", "lastSuccessfulAt"], "properties": {"enabled": {"type": "boolean"}, "provider": {"enum": ["clamav", null]}, "status": {"enum": ["disabled", "ready", "degraded", "down"]}, "message": {"type": "string"}, "counts": {"type": "object", "additionalProperties": false, "required": ["pending", "passed", "quarantined", "failed"], "properties": {"pending": {"type": "integer", "minimum": 0}, "passed": {"type": "integer", "minimum": 0}, "quarantined": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}}}, "recent": {"type": "array", "items": {"$ref": "#/components/schemas/MalwareScanEvent"}}, "mode": {"enum": ["local", "shared"]}, "lastSuccessfulAt": {"type": ["integer", "null"]}}}}},
      "MalwareScanEvent": {"type": "object", "additionalProperties": false, "required": ["id", "fileName", "resource", "bytes", "status", "code", "startedAt", "finishedAt", "durationMilliseconds"], "properties": {"id": {"type": "string", "pattern": "^[a-f0-9]{24}$"}, "fileName": {"type": "string", "maxLength": 255}, "resource": {"type": "string", "maxLength": 64}, "bytes": {"type": "integer", "minimum": 0}, "status": {"enum": ["pending", "passed", "quarantined", "failed"]}, "code": {"type": ["string", "null"]}, "startedAt": {"type": "integer"}, "finishedAt": {"type": ["integer", "null"]}, "durationMilliseconds": {"type": ["integer", "null"], "minimum": 0}}},
      "SignedUrlData": {"type": "object", "additionalProperties": false, "required": ["url", "expiresAt"], "properties": {"url": {"type": "string"}, "expiresAt": {"type": "integer"}}},
      "ChecksumData": {"type": "object", "additionalProperties": false, "required": ["algorithm", "checksum", "size"], "properties": {"algorithm": {"const": "sha256"}, "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size": {"type": "integer", "minimum": 0}}},
      "TextPreviewData": {"type": "object", "additionalProperties": false, "required": ["content", "truncated", "mimeType", "size"], "properties": {"content": {"type": "string"}, "truncated": {"type": "boolean"}, "mimeType": {"type": "string"}, "size": {"type": "integer", "minimum": 0}}},
      "UploadStateData": {"type": "object", "additionalProperties": false, "required": ["complete"], "properties": {"complete": {"type": "boolean"}, "entry": {"$ref": "#/components/schemas/Entry"}, "received": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}}},
      "BatchData": {"type": "object", "additionalProperties": false, "required": ["operation", "total", "succeeded", "failed", "results"], "properties": {"operation": {"enum": ["copy", "move", "delete", "rename", "image"]}, "total": {"type": "integer", "minimum": 0}, "succeeded": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "purgedItems": {"type": "integer", "minimum": 0}, "purgedBytes": {"type": "integer", "minimum": 0}, "results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "success"], "properties": {"path": {"type": "string"}, "success": {"type": "boolean"}, "entry": {"$ref": "#/components/schemas/Entry"}, "error": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}, "trash": {"$ref": "#/components/schemas/FlexibleBoundedData"}}}}}},
      "MetadataData": {"type": "object", "additionalProperties": false, "required": ["favorites", "tags", "recent"], "properties": {"favorites": {"type": "array", "items": {"type": "string"}}, "tags": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}, "recent": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "touchedAt"], "properties": {"path": {"type": "string"}, "touchedAt": {"type": "integer"}}}}}},
      "FlexibleBoundedData": {"type": "object", "minProperties": 1, "maxProperties": 32, "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"}, "additionalProperties": {"type": ["string", "integer", "number", "boolean", "null", "array", "object"]}},
      "ApiData": {"oneOf": [{"$ref": "#/components/schemas/EntryResult"}, {"$ref": "#/components/schemas/EntryList"}, {"$ref": "#/components/schemas/EmptyData"}, {"$ref": "#/components/schemas/HealthData"}, {"$ref": "#/components/schemas/SecurityStatusData"}, {"$ref": "#/components/schemas/SignedUrlData"}, {"$ref": "#/components/schemas/ChecksumData"}, {"$ref": "#/components/schemas/TextPreviewData"}, {"$ref": "#/components/schemas/UploadStateData"}, {"$ref": "#/components/schemas/BatchData"}, {"$ref": "#/components/schemas/MetadataData"}, {"$ref": "#/components/schemas/FlexibleBoundedData"}]},
      "EntryPathRequest": {"type": "object", "additionalProperties": false, "required": ["resource", "path"], "properties": {"resource": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}}},
      "EntryNameRequest": {"type": "object", "additionalProperties": false, "required": ["resource", "path", "name"], "properties": {"resource": {"type": "string", "minLength": 1}, "path": {"type": "string"}, "name": {"type": "string", "minLength": 1}}},
      "TransferRequest": {"type": "object", "additionalProperties": false, "required": ["resource", "path", "destination"], "properties": {"resource": {"type": "string"}, "path": {"type": "string"}, "destination": {"type": "string"}, "autoRename": {"type": "boolean"}}},
      "BatchRequest": {"type": "object", "additionalProperties": false, "required": ["operation", "resource", "paths"], "properties": {"operation": {"enum": ["copy", "move", "delete"]}, "resource": {"type": "string"}, "paths": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string"}}, "destination": {"type": "string"}, "autoRename": {"type": "boolean"}}},
      "BatchRenameRequest": {"type": "object", "additionalProperties": false, "required": ["resource", "renames"], "properties": {"resource": {"type": "string"}, "renames": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["path", "name"], "properties": {"path": {"type": "string"}, "name": {"type": "string"}}}}}},
      "TrashRequest": {"type": "object", "additionalProperties": false, "required": ["resource"], "properties": {"resource": {"type": "string"}, "conflict": {"enum": ["cancel", "overwrite", "rename"]}}},
      "ArchiveRequest": {"type": "object", "additionalProperties": false, "required": ["resource", "paths"], "properties": {"resource": {"type": "string"}, "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
      "MetadataRequest": {"type": "object", "additionalProperties": false, "required": ["resource", "path", "action"], "properties": {"resource": {"type": "string"}, "path": {"type": "string"}, "action": {"enum": ["favorite", "tags", "touch", "forget"]}, "favorite": {"type": "boolean"}, "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
      "MutationRequest": {"oneOf": [{"$ref": "#/components/schemas/EntryPathRequest"}, {"$ref": "#/components/schemas/EntryNameRequest"}, {"$ref": "#/components/schemas/TransferRequest"}, {"$ref": "#/components/schemas/BatchRequest"}, {"$ref": "#/components/schemas/BatchRenameRequest"}, {"$ref": "#/components/schemas/TrashRequest"}, {"$ref": "#/components/schemas/ArchiveRequest"}, {"$ref": "#/components/schemas/MetadataRequest"}]},
      "UploadRequest": {"type": "object", "additionalProperties": false, "required": ["resource", "path", "upload"], "properties": {"resource": {"type": "string"}, "path": {"type": "string"}, "overwrite": {"enum": ["0", "1"]}, "autoRename": {"enum": ["0", "1"]}, "upload": {"type": "string", "contentEncoding": "binary"}}},
      "ChunkUploadRequest": {"type": "object", "additionalProperties": false, "required": ["resource", "path", "name", "uploadId", "index", "total", "chunk"], "properties": {"resource": {"type": "string"}, "path": {"type": "string"}, "name": {"type": "string"}, "uploadId": {"type": "string"}, "index": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 1, "maximum": 1000}, "overwrite": {"enum": ["0", "1"]}, "autoRename": {"enum": ["0", "1"]}, "chunk": {"type": "string", "contentEncoding": "binary"}}},
      "CkeditorUploadRequest": {"type": "object", "additionalProperties": false, "required": ["upload"], "properties": {"upload": {"type": "string", "contentEncoding": "binary"}, "CKEditor": {"type": "string"}, "CKEditorFuncNum": {"type": "integer"}, "langCode": {"type": "string"}}},
      "CkeditorUploadResponse": {"type": "object", "additionalProperties": false, "required": ["uploaded"], "properties": {"uploaded": {"type": "integer", "enum": [0, 1]}, "fileName": {"type": "string"}, "url": {"type": "string"}, "error": {"type": "object", "additionalProperties": false, "required": ["message"], "properties": {"message": {"type": "string"}}}}},
      "ImageSave": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["copy", "overwrite"]}, "name": {"type": "string"}}},
      "ImageEditRequest": {"type": "object", "additionalProperties": false, "required": ["resource", "path", "actions", "save"], "properties": {"resource": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "actions": {"$ref": "#/components/schemas/ImageActions"}, "save": {"$ref": "#/components/schemas/ImageSave"}}},
      "ImageBatchRequest": {"type": "object", "additionalProperties": false, "required": ["resource", "paths", "actions", "save"], "properties": {"resource": {"type": "string", "minLength": 1}, "paths": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "actions": {"$ref": "#/components/schemas/ImageActions"}, "save": {"$ref": "#/components/schemas/ImageSave"}}}
      ,"LivenessEnvelope": {"type": "object", "additionalProperties": false, "required": ["success", "data"], "properties": {"success": {"const": true}, "data": {"type": "object", "additionalProperties": false, "required": ["status", "phpVersion", "bundle"], "properties": {"status": {"const": "ready"}, "phpVersion": {"type": "string"}, "bundle": {"const": "sofinder"}}}}}
      ,"DocumentPreviewJobRequest": {"type": "object", "additionalProperties": false, "required": ["resource", "path"], "properties": {"resource": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "retry": {"type": "boolean", "default": false}}}
