{
    "name": "sohophp/sofinder",
    "description": "An original, framework-friendly web file manager for PHP and Symfony applications",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/sohophp/sofinder",
    "keywords": ["file-manager", "symfony", "ckeditor", "upload", "image-manager"],
    "support": {
        "issues": "https://github.com/sohophp/sofinder/issues",
        "source": "https://github.com/sohophp/sofinder"
    },
    "require": {
        "php": "^8.5",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-core": "^7.4",
        "symfony/security-csrf": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "suggest": {
        "ext-gd": "Required for thumbnails and image editing",
        "ext-zip": "Required for ZIP archive downloads"
    },
    "autoload": {
        "psr-4": {
            "SohoPHP\\SoFinder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SohoPHP\\SoFinder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
