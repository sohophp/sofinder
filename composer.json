{
    "name": "sohophp/sofinder",
    "description": "Compatibility meta package for the SoFinder Symfony bridge",
    "type": "metapackage",
    "license": "MIT",
    "homepage": "https://sofinder.sohophp.app/",
    "keywords": ["file-manager", "symfony", "ckeditor", "upload", "image-manager"],
    "support": {
        "issues": "https://github.com/sohophp/sofinder/issues",
        "source": "https://github.com/sohophp/sofinder"
    },
    "require": {
        "php": "^8.1",
        "sohophp/sofinder-symfony": "self.version"
    },
    "require-dev": {
        "guzzlehttp/psr7": "^2.7",
        "laminas/laminas-diactoros": "^3.6",
        "laminas/laminas-httphandlerrunner": "^2.13",
        "mezzio/mezzio": "^3.20",
        "mezzio/mezzio-fastroute": "^3.13",
        "nyholm/psr7": "^1.8",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.15",
        "sohophp/sofinder-laravel": "self.version",
        "sohophp/sofinder-psr15": "self.version"
    },
    "conflict": {
        "sohophp/sofinder-legacy": "*"
    },
    "scripts": {
        "test": "./scripts/php-bin.sh vendor/bin/phpunit",
        "phpstan": "./scripts/php-bin.sh vendor/bin/phpstan analyse --no-progress --memory-limit=512M"
    },
    "suggest": {
        "ext-gd": "Required for thumbnails and image editing",
        "ext-imagick": "Adds ICO processing support when its ImageMagick coder is installed",
        "ext-pdo": "Enables the optional multi-node shared database state store",
        "ext-redis": "Enables the optional multi-node shared Redis state store",
        "ext-zip": "Required for ZIP archive downloads",
        "symfony/messenger": "Enables asynchronous maintenance and document preview jobs"
    },
    "autoload-dev": {
        "psr-4": {
            "SohoPHP\\SoFinder\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": ["/docs/public/screenshots"]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/sofinder-core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/sofinder-http",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/sofinder-laravel",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/sofinder-psr15",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/sofinder-symfony",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
