{
  "name": "sohophp/sofinder-symfony74-example",
  "description": "Local Symfony 7.4 integration example for SoFinder",
  "type": "project",
  "license": "MIT",
  "repositories": [
    { "type": "path", "url": "../..", "options": { "symlink": false, "versions": { "sohophp/sofinder": "dev-main" } } },
    { "type": "path", "url": "../../packages/sofinder-core", "options": { "symlink": false, "versions": { "sohophp/sofinder-core": "dev-main" } } },
    { "type": "path", "url": "../../packages/sofinder-http", "options": { "symlink": false, "versions": { "sohophp/sofinder-http": "dev-main" } } },
    { "type": "path", "url": "../../packages/sofinder-symfony", "options": { "symlink": false, "versions": { "sohophp/sofinder-symfony": "dev-main" } } },
    { "type": "path", "url": "../../packages/sofinder-s3", "options": { "symlink": false, "versions": { "sohophp/sofinder-s3": "dev-main" } } }
  ],
  "require": {
    "php": "^8.2",
    "sohophp/sofinder": "dev-main",
    "sohophp/sofinder-s3": "dev-main",
    "symfony/dotenv": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": { "allow-plugins": { "symfony/runtime": true }, "sort-packages": true },
  "extra": { "runtime": { "class": "Symfony\\Component\\Runtime\\SymfonyRuntime" } }
}
