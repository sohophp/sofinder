{
  "name": "sohophp/sofinder-symfony64-example",
  "type": "project",
  "repositories": [{ "type": "path", "url": "../..", "options": { "symlink": false } }],
  "require": {
    "php": "^8.2",
    "sohophp/sofinder": "dev-main",
    "symfony/framework-bundle": "6.4.*",
    "symfony/runtime": "6.4.*",
    "symfony/security-bundle": "6.4.*",
    "symfony/yaml": "6.4.*"
  },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "config": { "allow-plugins": { "symfony/runtime": true }, "sort-packages": true },
  "extra": { "runtime": { "class": "Symfony\\Component\\Runtime\\SymfonyRuntime" } }
}
