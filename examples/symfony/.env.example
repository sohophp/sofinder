# Use the S3-specific Symfony configuration in config/packages/s3/.
APP_ENV=s3
APP_DEBUG=1

# Use a non-production bucket and a restricted application key.
# Backblaze example: https://s3.us-west-004.backblazeb2.com
SOFINDER_S3_ENDPOINT=
SOFINDER_S3_REGION=
SOFINDER_S3_BUCKET=
SOFINDER_S3_ROOT=sofinder-browser-test
SOFINDER_S3_ACCESS_KEY=
SOFINDER_S3_SECRET_KEY=
SOFINDER_S3_SESSION_TOKEN=
SOFINDER_S3_USE_PATH_STYLE_ENDPOINT=0
