# Use the S3-specific Symfony configuration in config/packages/s3/.
APP_ENV=s3
APP_DEBUG=1

# Use a non-production bucket and a restricted application key.
# Backblaze example: https://s3.us-west-004.backblazeb2.com
SOFINDER_PROVIDER_ENDPOINT=
SOFINDER_PROVIDER_REGION=
SOFINDER_PROVIDER_BUCKET=
SOFINDER_PROVIDER_PREFIX=sofinder-browser-test
SOFINDER_PROVIDER_PUBLIC_URL=
SOFINDER_PROVIDER_ACCESS_KEY=
SOFINDER_PROVIDER_SECRET_KEY=
SOFINDER_PROVIDER_SESSION_TOKEN=
SOFINDER_PROVIDER_USE_PATH_STYLE_ENDPOINT=0
