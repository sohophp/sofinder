# Safe defaults required by Symfony Runtime. Local S3 credentials belong in
# .env.local, which is ignored by Git.
APP_ENV=dev
APP_DEBUG=1

# Safe optional S3 defaults. Required endpoint, region, bucket and credentials
# remain intentionally undefined so an incomplete provider cannot start.
SOFINDER_PROVIDER_PREFIX=
SOFINDER_PROVIDER_PUBLIC_URL=
SOFINDER_PROVIDER_SESSION_TOKEN=
SOFINDER_PROVIDER_USE_PATH_STYLE_ENDPOINT=0
# Change to 1 only after clamd is listening on tcp://127.0.0.1:3310.
SOFINDER_CLAMAV_ENABLED=0
