{
    "name": "sohophp/sofinder-laravel12-example",
    "description": "Runnable Laravel 12 integration example for SoFinder",
    "type": "project",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "../../packages/sofinder-core", "options": { "symlink": true, "versions": { "sohophp/sofinder-core": "dev-main" } } },
        { "type": "path", "url": "../../packages/sofinder-http", "options": { "symlink": true, "versions": { "sohophp/sofinder-http": "dev-main" } } },
        { "type": "path", "url": "../../packages/sofinder-laravel", "options": { "symlink": true, "versions": { "sohophp/sofinder-laravel": "dev-main" } } }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "12.*",
        "sohophp/sofinder-laravel": "dev-main"
    },
    "autoload": { "psr-4": { "App\\": "app/" } },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": { "platform": { "php": "8.2.0" }, "sort-packages": true }
}
